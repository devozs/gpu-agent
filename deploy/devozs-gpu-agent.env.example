# Environment for the devozs-gpu-agent systemd service.
# Copy to /etc/devozs-gpu-agent.env (or pass --env-file to install-service.sh)
# and edit. The agent reads these on start; no quotes needed around values.

# Management base URL, INCLUDING the /api context path.
MGMT_URL=http://10.111.56.26/api

# Accelerator family on this box: CUDA or HPU.
AGENT_TYPE=HPU

# Gaudi only: force lazy mode. SynapseAI 1.24 defaults to eager, which breaks
# HPU graphs. Harmless on CUDA. Leave at 1 for HPU.
PT_HPU_LAZY_MODE=1

# Gaudi only: path to the TPC kernel library. REQUIRED for the systemd service —
# the Habana venv's activate script sets this, but systemd doesn't run it, so
# without it the graph compiler can't translate basic kernels and EVERY training
# run dies with "synStatus 26 ... layer_norm_fwd_f32 ... Graph compile failed"
# (training works in an interactive shell but not as a service — the classic
# shell-vs-systemd trap). The path is stable across SynapseAI installs.
GC_KERNEL_PATH=/usr/lib/habanalabs/libtpc_kernels.so

# One-time enrollment code. ONLY needed for the very first run on a box that has
# never enrolled; after that the token is cached and this can be removed. Issue
# a fresh code from the admin UI (Compute Resources → Re-issue code) if needed.
#ENROLL_CODE=HRT-xxxx

# --- corporate proxy (REQUIRED when HuggingFace is only reachable via proxy) -
# The systemd service does NOT inherit your login shell's environment, so the
# proxy vars your interactive shell has must be set HERE or the agent can't
# reach huggingface.co to pull base models. Real jobs fail with
# "[Errno 101] Network is unreachable" the moment from_pretrained() runs, even
# though `curl https://huggingface.co` works in your shell (your shell exports
# these; the service does not).
# NO_PROXY MUST include the internal management host so heartbeat/claim/progress
# traffic bypasses the proxy — a 10.x mgmt host is covered by 10.0.0.0/8 below.
#HTTP_PROXY=http://proxy-dmz.intel.com:912
#HTTPS_PROXY=http://proxy-dmz.intel.com:912
#NO_PROXY=127.0.0.1,localhost,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,.intel.com

# --- optional ---------------------------------------------------------------
# Human name for the resource (defaults to the hostname).
#AGENT_NAME=gaudi3-8card-vm
# Seconds between heartbeat/claim polls.
#POLL_INTERVAL=5
# Where the cached bearer token lives (default ~/.devozs_gpu_agent/agent-token.json).
#AGENT_TOKEN_FILE=/home/labuser/.devozs_gpu_agent/agent-token.json
# Local scratch for datasets/checkpoints.
#AGENT_WORK_DIR=/tmp/devozs-gpu-agent
# HuggingFace push-to-Hub (only when a session enables it).
#HF_TOKEN=hf_xxxx
#HF_HUB_NAMESPACE=devozs
